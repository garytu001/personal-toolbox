<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="80dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_card" android:elevation="0dp" android:translationZ="0dp"
    android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/dragHandle"
        android:layout_width="36dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_drag_handle" android:contentDescription="@string/drag_module" android:padding="8dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/moduleName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/moduleCount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:fontFeatureSettings="tnum" android:maxLines="1" />
    </LinearLayout>
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/moduleSwitch"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
        app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track" />
</LinearLayout>
