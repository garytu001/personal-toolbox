<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:elevation="0dp" android:translationZ="0dp"
    android:paddingStart="8dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/dragHandle"
            android:layout_width="36dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_drag_handle" android:contentDescription="@string/drag_module" android:padding="8dp" />
        <TextView android:id="@+id/moduleName" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="4dp" android:paddingEnd="8dp"
            android:textColor="@color/text_primary" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/moduleControls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp" />
</LinearLayout>
