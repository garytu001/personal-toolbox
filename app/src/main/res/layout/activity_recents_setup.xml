<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/recents_title" android:textSize="20sp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="@color/text_primary" android:textSize="16sp"
            android:accessibilityLiveRegion="polite" android:fontFeatureSettings="tnum" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/recents_instructions"
            android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFeatureSettings="tnum" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/enableControl"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_button" android:text="@string/recents_enable"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/openDebugging"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:background="@drawable/bg_button" android:text="@string/recents_debug_settings"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/pairingPort"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp"
            android:hint="@string/recents_pair_port" android:inputType="number" android:maxLength="5"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:fontFeatureSettings="tnum" />
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/pairingCode"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="@string/recents_pair_code" android:inputType="numberPassword" android:maxLength="6"
            android:saveEnabled="false" android:importantForAutofill="no"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:fontFeatureSettings="tnum" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/pairDevice"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:background="@drawable/bg_button" android:text="@string/recents_pair"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/connectionPort"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp"
            android:hint="@string/recents_connect_port" android:inputType="number" android:maxLength="5"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:fontFeatureSettings="tnum" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/connectDevice"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:background="@drawable/bg_button" android:text="@string/recents_connect"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/disconnectDevice"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
            android:background="@drawable/bg_button" android:text="@string/recents_disconnect"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/openLicenses"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_button" android:text="@string/recents_licenses"
            android:textColor="@color/text_primary" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
